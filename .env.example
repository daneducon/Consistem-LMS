# Chaves das suas 3 escolas na Hotscool:
HOTSCOOL_API_KEY_1=sua_chave_escola_1
HOTSCOOL_API_KEY_2=sua_chave_escola_2
HOTSCOOL_API_KEY_3=sua_chave_escola_3

# Teto global de matrículas ativas somando todas as escolas (contrato Hotscool).
HOTSCOOL_MAX_ACTIVE_ENROLLMENTS=200

# Portal aberto pelo botao "Continuar Curso". Pode ser substituido pelo
# dominio personalizado da escola, quando houver.
HOTSCOOL_STUDENT_PORTAL_URL=https://app.hotscool.com

# Origens autorizadas no desenvolvimento/produção, separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:5173

# Hops de proxy confiável para extrair o IP real do X-Forwarded-For.
# Padrão: 1 na Vercel, 0 local. Não aumente sem um proxy que anexe o IP real.
# TRUST_PROXY_HOPS=1

# Paralelismo máximo nas chamadas à Hotscool (1-8, padrão 4).
# HOTSCOOL_CONCURRENCY=4

# Google Identity Services e sessão administrativa. Gere AUTH_SECRET com:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
AUTH_SECRET=

# Política obrigatória e default-deny. Papéis: viewer, operator ou admin.
# Escolas usam os índices das HOTSCOOL_API_KEY_n; admin pode usar ["*"].
AUTHORIZATION_POLICY={"auditor@example.com":{"role":"viewer","schools":[0]},"operador@example.com":{"role":"operator","schools":[0,1]}}

# Opcional: habilita as ações de redação assistida no gerador de plano de aula.
OPENROUTER_API_KEY=

# WordPress Colab (colab.consistem.com.br) - perfil do colaborador: Cargo/Funcao,
# Area de Negocio e Times. Gere a Application Password em:
#   WP Admin -> Usuarios -> seu perfil -> Application Passwords.
# IMPORTANTE: para cruzar por E-MAIL (caminho exato), o usuario precisa ser
# ADMINISTRADOR (capacidade list_users). Sem admin, o sistema cai para a
# heuristica de username (prefixo do e-mail = user_login do WP), que pode
# falhar em logins fora do padrao.
# Preencha no .env (que e ignorado pelo Git), NUNCA aqui.
WP_SITE_URL=https://colab.consistem.com.br
WP_API_USER=
WP_APP_PASSWORD=

# Banco do quiz de Fundamentos de IA (aba Avaliações). A chave de serviço fica só no servidor.
SUPABASE_URL=https://wmckowpoeqdotnpiopad.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
